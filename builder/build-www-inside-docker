#!/bin/sh

set -eu

# clear previous build
rm -rf /build/*

# Apply the NJOY SECURITY overlay to the pinned frontend source before Vite
# builds it, so every package contains the same branded interface.
node /src/branding/apply.mjs /src/www

# Build web assets and their source/dependency inventory.
node .kasm-supply-chain.mjs

# copy all to build dir
cp -R ./dist/* /build/
